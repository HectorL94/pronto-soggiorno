<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Única permisión de red: solo se usa para questure.poliziadistato.it (ver :core PortalOnlyInterceptor). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: avisos cuando cambia el estado. Se pide al usuario; la app funciona sin él. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      WorkManager añade por su cuenta el permiso y el servicio de "primer plano". La app nunca
      trabaja en primer plano (solo tareas periódicas normales), así que se quitan: menos permisos
      y nada que justificar en Google Play.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />

    <!--
      Privacidad:
      - allowBackup=false + dataExtractionRules: los datos no salen del teléfono ni en copias
        en la nube ni en transferencias a otro dispositivo.
      - networkSecurityConfig: prohíbe tráfico sin cifrar (HTTP).
    -->
    <application
        android:name=".ProntoSoggiornoApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ProntoSoggiorno">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />

        <!-- Guarda el idioma elegido dentro de la app en Android < 13. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>
