<?xml version="1.0" encoding="utf-8"?>
<!-- Solo HTTPS, con los certificados del sistema. Sin certificate pinning: Akamai rota certificados. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
